    "tokenColors": [
        {
            "name": "Comentarios",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {"foreground": "#7d7e85", "fontStyle": "italic"}
        },
        {
            "name": "Cadenas",
            "scope": ["string", "string.quoted"],
            "settings": {"foreground": "#8fc98a"}
        },
        {
            "name": "Regex y escapes",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": {"foreground": "#b49ae0"}
        },
        {
            "name": "Números y constantes",
            "scope": ["constant.numeric", "constant.language", "constant.other"],
            "settings": {"foreground": "#d9a25f"}
        },
        {
            "name": "Palabras clave",
            "scope": ["keyword", "keyword.control", "storage", "storage.type"],
            "settings": {"foreground": "#6ea8fe"}
        },
        {
            "name": "Operadores",
            "scope": ["keyword.operator"],
            "settings": {"foreground": "#9b9ca3"}
        },
        {
            "name": "Funciones",
            "scope": ["entity.name.function", "support.function", "meta.function-call"],
            "settings": {"foreground": "#77c2c9"}
        },
        {
            "name": "Tipos y clases",
            "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
            "settings": {"foreground": "#d9a25f"}
        },
        {
            "name": "Variables",
            "scope": ["variable.other", "variable.other.property"],
            "settings": {"foreground": "#e3e4e8"}
        },
        {
            "name": "Parámetros",
            "scope": ["variable.parameter"],
            "settings": {"foreground": "#c6c7cd"}
        },
        {
            "name": "this/self/super",
            "scope": ["variable.language"],
            "settings": {"foreground": "#e5686f"}
        },
        {
            "name": "Tags HTML/XML",
            "scope": ["entity.name.tag"],
            "settings": {"foreground": "#e5686f"}
        },
        {
            "name": "Atributos HTML",
            "scope": ["entity.other.attribute-name"],
            "settings": {"foreground": "#d9a25f"}
        },
        {
            "name": "CSS propiedades y unidades",
            "scope": ["support.type.property-name.css", "support.constant.unit"],
            "settings": {"foreground": "#77c2c9"}
        },
        {
            "name": "Decoradores",
            "scope": ["meta.decorator", "storage.modifier"],
            "settings": {"foreground": "#d9a25f"}
        },
        {
            "name": "Puntuación",
            "scope": ["punctuation.separator", "punctuation.terminator", "meta.brace"],
            "settings": {"foreground": "#9b9ca3"}
        },
        {
            "name": "Inválido",
            "scope": ["invalid"],
            "settings": {"foreground": "#e5686f", "fontStyle": "underline"}
        }
    ]
}
