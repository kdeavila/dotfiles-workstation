# kanshi — perfiles de pantallas (Win+P)
# El menú (Super+P → wlogout) conmuta con: kanshictl switch <perfil>
# Al conectar/desconectar, kanshi auto-aplica el PRIMER perfil que calce
# (por eso extend-tv va primero y solo-laptop al final).

profile extend-tv {
    output eDP-1 enable mode 1920x1080@60 scale 1.2 position 0,0
    output HDMI-A-1 enable mode 3840x2160@60 scale 1.5 position 1600,0
}

profile clonar {
    output eDP-1 enable mode 1920x1080@60 scale 1.2 position 0,0
    output HDMI-A-1 enable mode 1920x1080@60 scale 1.2 position 0,0
}

profile solo-tv {
    output HDMI-A-1 enable mode 3840x2160@60 scale 1.5 position 0,0
    output eDP-1 disable
}

profile solo-laptop {
    output eDP-1 enable mode 1920x1080@60 scale 1.2 position 0,0
    output HDMI-A-1 disable
}
